          { "kind": "progress", "text": "Sweet", "meta": "-30%", "at": 0.5, "doneAt": 1.5 },
          { "kind": "check", "text": "Umami", "meta": "unchanged", "at": 1.0, "doneAt": 1.6 }
        ]
      }
    },
    {
      "kicker": "// 04 · the fix",
      "transition": "halftone",
      "say": ["So airlines add *extra salt*", "and order *tomato juice.*"],
