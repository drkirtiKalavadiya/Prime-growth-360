# ---- Server ----
# true = just for you: no login, no plans, no payments, unlimited usage. Keep the server private.
PERSONAL_MODE=true
PORT=3000
# Long random string. Signs nothing on the client but derives the key that encrypts
# stored Instagram tokens. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string
# Set to true when served over HTTPS (production) so the session cookie is Secure.
COOKIE_SECURE=false
# Where the JSON database lives.
DATA_FILE=./data/db.json

# ---- Instagram Graph API (per-user tokens are entered in the app's Settings page) ----
GRAPH_API_VERSION=v23.0
# Seconds between live Reel refreshes when a real Instagram account is connected.
LIVE_INTERVAL_SECONDS=60
# Minutes to cache Graph API responses (protects your rate limit).
CACHE_MINUTES=5

# ---- Keyword demand signal ----
# true = expand seed keywords with live public autocomplete suggestions (what people actually type).
ENABLE_WEB_SUGGEST=true

# ---- AI captions (optional) ----
# Without a key the deterministic SEO/AEO caption engine is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Billing ----
# Stripe Payment Links for each paid plan. Leave blank in development.
STRIPE_LINK_PRO=
STRIPE_LINK_AGENCY=
# Development only: lets a signed-in user switch plans without paying.
DEV_ALLOW_SELF_UPGRADE=true
# Comma-separated emails that get the admin plan-switch endpoint.
ADMIN_EMAILS=
